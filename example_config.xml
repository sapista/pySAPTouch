<?xml version="1.0"?>
<!-- This is an example config file, copy it with your setting and rename as config.xml -->
<config>
    <osc_net>
        <daw_ip>127.0.0.1</daw_ip>
        <daw_port>3819</daw_port>
        <recv_port>8000</recv_port>
    </osc_net>
    <avr_com>
        <serial_port>/dev/ttyUSB0</serial_port>
        <baudrate>250000</baudrate>
        <fader_min>50</fader_min>
        <fader_max>1000</fader_max>
    </avr_com>
    <encoder>
        <reverse_dir>True</reverse_dir>
        <acceleration>0.02</acceleration>
        <ticks_for_marker>4</ticks_for_marker>
    </encoder>
    <misc>
        <window_width>1280</window_width>
        <window_height>800</window_height>
        <window_maximize>False</window_maximize>
        <meter_waveform_speed>10</meter_waveform_speed>
        <hide_cursor>True</hide_cursor>
    </misc>
    <debug>
        <log_invalid_messages>False</log_invalid_messages>
    </debug>
</config>



